# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Для этого бэкенда удобнее service_role (обходит RLS).
# Анонимный anon-ключ тоже сработает, если в таблицах открыты нужные политики.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY

# Google AI Studio → API keys (чат-ассистент)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
